# Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Database=hotel_saas;Username=postgres;Password=your_password;Port=5432

# JWT Configuration
Jwt__Key=SUPER_SECRET_JWT_KEY_FOR_HOTEL_SAAS_PRODUCTION_MIN_32_CHARS
Jwt__Issuer=HotelSaaS.Api
Jwt__Audience=HotelSaaS.Client

# Supabase Credentials
Supabase__Url=https://your-supabase-id.supabase.co
Supabase__ServiceRoleKey=your_supabase_service_role_key

# Razorpay Integration
Razorpay__KeyId=rzp_test_your_key_id
Razorpay__KeySecret=your_razorpay_secret
Razorpay__WebhookSecret=your_razorpay_webhook_secret

# Email Configuration
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SenderEmail=no-reply@hotelsaas.com
Email__SenderPassword=your_smtp_app_password
